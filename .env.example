# Map tiles default to Esri Light Gray Canvas (no key required).
# Only needed if switching back to CARTO Positron in
# src/games/snapshot/controller.ts (see TILE comment there).
# Note: VITE_ vars are exposed to the browser bundle, so restrict any key
# to the deployed hostname in CARTO rather than treating it as a server secret.
VITE_CARTO_API_KEY=
