{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "types": ["node"],
    "outDir": "dist-test",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*", "server/**/*", "tests"],
  "exclude": [
    "src/main.ts",
    "src/games/registry.ts",
    "src/**/controller.ts",
    "src/**/view.ts",
    "src/**/icons.ts",
    "src/leaderboard/view.ts",
    "server/index.ts",
    "vite.config.ts"
  ]
}
