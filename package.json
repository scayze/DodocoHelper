{
  "name": "dodoco-solver",
  "private": true,
  "version": "1.0.0",
  "description": "Crown puzzle companion web app: upload a board screenshot, get every crown placed.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run build:server && node --watch dist-server/server/index.js",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/*.test.js && npm run test:fixtures",
    "test:fixtures": "node tests/fixtures-run.mjs --check",
    "fixtures": "tsc -p tsconfig.test.json && node tests/fixtures-run.mjs",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('dist-test',{recursive:true,force:true})\"",
    "typecheck": "tsc -b"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
