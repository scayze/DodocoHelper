:80 {
	encode zstd gzip
	root * /srv
	handle /api/* {
		reverse_proxy api:3001
	}
	handle {
		@healthz {
			path /healthz
		}
		respond @healthz 200
		# SPA fallback for the Tinder curator (same app, /tinder route).
		@tinder {
			path /tinder /tinder/*
		}
		rewrite @tinder /index.html
		file_server
	}
}